# URL of the API. Leave empty in development to use the Vite proxy
# (requests to /api go to http://localhost:5000, or VITE_DEV_API_PROXY).
# In production set it to the deployed backend, e.g. https://ai-evaluaite.onrender.com
VITE_API_URL=

# Optional: where the dev server proxies /api to.
# VITE_DEV_API_PROXY=http://localhost:5000
