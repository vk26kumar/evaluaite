# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# At least 32 random characters in production. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API, comma-separated. The first one is
# where Google sign-in redirects back to.
CLIENT_URL=http://localhost:5173

# Public URL of this API. Used to build the Google OAuth callback URL.
# On Render this defaults to RENDER_EXTERNAL_URL automatically.
SERVER_URL=http://localhost:5000

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model that accepts images and PDFs. Pin a specific version in
# production if you need grading to stay identical across model releases.
GEMINI_MODEL=gemini-flash-latest
# Used automatically when the main model is overloaded, rate-limited or retired.
# Leave empty to turn fallback off.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Optional: Google sign-in. Authorised redirect URI in Google Cloud Console:
#   <SERVER_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# How many answer sheets are graded at the same time.
MAX_CONCURRENT_JOBS=2
